{
  "name": "direction-mcp",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP server for persistent project direction & context",
  "scripts": {
    "build": "tsc",
    "dev":   "node --experimental-sqlite --import tsx src/index.ts",
